; Engine configuration file.
; Edit through the Godot editor when possible.
;
; Game Factory baseline: Godot 4.7.2 stable
; Mobile-first reference canvas with responsive expansion for every aspect ratio.

config_version=5

[application]
config/name="REALM ALLIANCE V2"
run/main_scene="res://realm_alliance/combat/gruenhain_vertical_slice.tscn"

[display]
window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=720
window/size/window_height_override=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.025, 0.03, 0.04, 1)
